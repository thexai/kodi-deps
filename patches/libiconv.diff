+cmake_minimum_required(VERSION 3.15)
+
+project(iconv VERSION 1.19 LANGUAGES C)
+
+option(GENERATE_FILES "Generate files needed for the build" OFF)
+
+if(WIN32)
+  set(CMAKE_DEBUG_POSTFIX "d")
+endif()
+
+if(GENERATE_FILES)
+  add_executable(genaliases
+    ${CMAKE_CURRENT_SOURCE_DIR}/lib/genaliases.c)
+  target_include_directories(genaliases PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/lib>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>)
+  add_custom_target(gen-aliases
+    COMMAND genaliases aliases.gperf canonical.sh canonical_local.sh
+    BYPRODUCTS ${CMAKE_CURRENT_SOURCE_DIR}/lib/aliases.h)
+  # @Todo: implement these commands or Windows alternative
+  # gperf -m 10 aliases.gperf > tmp.h
+  # sed -e 's/^\(const struct alias \)/static \1/' < tmp.h > aliases.h
+  # sh canonical.sh > canonical.h
+  # sh canonical_local.sh > canonical_local.h
+
+  add_executable(genaliases2
+    ${CMAKE_CURRENT_SOURCE_DIR}/lib/genaliases2.c)
+  target_compile_definitions(genaliases2 PRIVATE USE_DOS)
+  target_include_directories(genaliases2 PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/lib>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>)
+  add_custom_target(gen-aliases2
+    COMMAND genaliases2 dos aliases_dos.h canonical_dos.h
+    BYPRODUCTS ${CMAKE_CURRENT_SOURCE_DIR}/lib/aliases.h)
+
+  add_executable(genflags
+    ${CMAKE_CURRENT_SOURCE_DIR}/lib/genflags.c)
+  target_include_directories(genflags PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/lib>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>)
+  add_custom_target(gen-flags
+    COMMAND genflags > ${CMAKE_CURRENT_SOURCE_DIR}/lib/flags.h
+    BYPRODUCTS ${CMAKE_CURRENT_SOURCE_DIR}/lib/flags.h)
+
+  add_executable(gentranslit
+    ${CMAKE_CURRENT_SOURCE_DIR}/lib/gentranslit.c)
+  target_include_directories(gentranslit PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/lib>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>)
+  add_custom_target(gen-translit
+    COMMAND gentranslit < ${CMAKE_CURRENT_SOURCE_DIR}/lib/translit.def > ${CMAKE_CURRENT_SOURCE_DIR}/lib/translit.h
+    BYPRODUCTS ${CMAKE_CURRENT_SOURCE_DIR}/lib/translit.h)
+endif(GENERATE_FILES)
