--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -495,10 +495,30 @@ target_compile_definitions(
 if (WIN32)
   target_compile_definitions(
     freetype PRIVATE _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS)
