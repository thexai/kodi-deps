+      /sdl-
+  )
+  target_link_options(freetype
+    PRIVATE
+      /INCREMENTAL:NO
+      /debug:full
+  )
 else ()
   # Windows handles exports with DLL_EXPORT defined above.
   set_target_properties(freetype PROPERTIES
